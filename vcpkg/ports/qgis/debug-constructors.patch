From 65140e8e177c7cc5fe4c3e5c04793ca2760b01a8 Mon Sep 17 00:00:00 2001
From: Michael Schmuki <mschmuki@ethz.ch>
Date: Sun, 26 Oct 2025 14:32:21 +0100
Subject: [PATCH 1/3] Add debug prints to QgsQuickMapSettings
 constructor/destructor

---
 src/quickgui/qgsquickmapsettings.cpp | 6 ++++++
 src/quickgui/qgsquickmapsettings.h   | 2 +-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/quickgui/qgsquickmapsettings.cpp b/src/quickgui/qgsquickmapsettings.cpp
index 5cdc0848c50..6730f9bc14c 100644
--- a/src/quickgui/qgsquickmapsettings.cpp
+++ b/src/quickgui/qgsquickmapsettings.cpp
@@ -25,6 +25,7 @@
 QgsQuickMapSettings::QgsQuickMapSettings( QObject *parent )
   : QObject( parent )
 {
+  qDebug() << "[QgsQuickMapSettings] Constructor called, this =" << this;
   // Connect signals for derived values
   connect( this, &QgsQuickMapSettings::destinationCrsChanged, this, &QgsQuickMapSettings::mapUnitsPerPixelChanged );
   connect( this, &QgsQuickMapSettings::extentChanged, this, &QgsQuickMapSettings::mapUnitsPerPixelChanged );
@@ -381,3 +382,8 @@ void QgsQuickMapSettings::setZRangeUpper( const double &upper )
   mMapSettings.setZRange( QgsDoubleRange( zRange.lower(), upper, zRange.includeLower(), zRange.includeUpper() ) );
   emit zRangeChanged();
 }
+
+QgsQuickMapSettings::~QgsQuickMapSettings()
+{
+  qDebug() << "[QgsQuickMapSettings] Destructor called, this =" << this;
+}
diff --git a/src/quickgui/qgsquickmapsettings.h b/src/quickgui/qgsquickmapsettings.h
index 78b795f956d..a6a06921e7e 100644
--- a/src/quickgui/qgsquickmapsettings.h
+++ b/src/quickgui/qgsquickmapsettings.h
@@ -148,7 +148,7 @@ class QUICK_EXPORT QgsQuickMapSettings : public QObject
   public:
     //! Create new map settings
     explicit QgsQuickMapSettings( QObject *parent = nullptr );
-    ~QgsQuickMapSettings() = default;
+    ~QgsQuickMapSettings();
 
     //! Clone map settings
     QgsMapSettings mapSettings() const;
-- 
