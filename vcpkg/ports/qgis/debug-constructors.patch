From e1ff112fa08b0828148f47eab8fa62f7c8d10e18 Mon Sep 17 00:00:00 2001
From: Michael Schmuki <mschmuki@ethz.ch>
Date: Sun, 26 Oct 2025 14:36:07 +0100
Subject: [PATCH 3/3] Add debug prints to QgsMapSettings constructor/destructor
 with Rule of Five

Implements the Rule of Five (copy constructor, copy assignment, move constructor,
move assignment, and destructor) to prevent stack corruption when QgsMapSettings
objects are copied. All special member functions are explicitly defined and
defaulted to ensure proper copy/move semantics.

This fixes the stack corruption issue: "Run-Time Check Failure #2 - Stack around
the variable 'mapSettings' was corrupted."
---
 src/core/qgsmapsettings.cpp | 13 +++++++++++++
 src/core/qgsmapsettings.h   |  7 +++++++
 2 files changed, 20 insertions(+)

diff --git a/src/core/qgsmapsettings.cpp b/src/core/qgsmapsettings.cpp
index 8a1a966f23b..3c0e9aa5333 100644
--- a/src/core/qgsmapsettings.cpp
+++ b/src/core/qgsmapsettings.cpp
@@ -39,12 +39,21 @@ QgsMapSettings::QgsMapSettings()
   , mFlags( Qgis::MapSettingsFlag::Antialiasing | Qgis::MapSettingsFlag::UseAdvancedEffects | Qgis::MapSettingsFlag::DrawLabeling | Qgis::MapSettingsFlag::DrawSelection )
   , mSegmentationTolerance( M_PI_2 / 90 )
 {
+  qDebug() << "[QgsMapSettings] Default constructor called, this =" << this;
   mScaleCalculator.setMapUnits( Qgis::DistanceUnit::Unknown );
   mSimplifyMethod.setSimplifyHints( Qgis::VectorRenderingSimplificationFlag::NoSimplification );
 
   updateDerived();
 }
 
+QgsMapSettings::QgsMapSettings( const QgsMapSettings &other ) = default;
+
+QgsMapSettings &QgsMapSettings::operator=( const QgsMapSettings &other ) = default;
+
+QgsMapSettings::QgsMapSettings( QgsMapSettings &&other ) noexcept = default;
+
+QgsMapSettings &QgsMapSettings::operator=( QgsMapSettings &&other ) noexcept = default;
+
 void QgsMapSettings::setMagnificationFactor( double factor, const QgsPointXY *center )
 {
   const double ratio = mMagnificationFactor / factor;
@@ -916,3 +925,7 @@ void QgsMapSettings::setElevationShadingRenderer( const QgsElevationShadingRende
   mShadingRenderer = elevationShadingRenderer;
 }
 
+QgsMapSettings::~QgsMapSettings()
+{
+  qDebug() << "[QgsMapSettings] Destructor called, this =" << this;
+}
diff --git a/src/core/qgsmapsettings.h b/src/core/qgsmapsettings.h
index 3e88a34faea..547bf9889c1 100644
--- a/src/core/qgsmapsettings.h
+++ b/src/core/qgsmapsettings.h
@@ -92,6 +92,13 @@ class CORE_EXPORT QgsMapSettings : public QgsTemporalRangeObject
   public:
     QgsMapSettings();
 
+    // Rule of Five: explicitly define copy/move operations and destructor
+    QgsMapSettings( const QgsMapSettings &other );
+    QgsMapSettings &operator=( const QgsMapSettings &other );
+    QgsMapSettings( QgsMapSettings &&other ) noexcept;
+    QgsMapSettings &operator=( QgsMapSettings &&other ) noexcept;
+    ~QgsMapSettings();
+
     /**
      * Returns geographical coordinates of the rectangle that should be rendered.
      *
-- 
